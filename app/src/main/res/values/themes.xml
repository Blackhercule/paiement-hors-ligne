<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Pegasus.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fond</item>
        <item name="android:colorPrimary">@color/vert</item>
        <item name="android:colorPrimaryDark">@color/vert_fonce</item>
        <item name="android:colorAccent">@color/vert</item>
        <item name="android:colorControlActivated">@color/vert</item>
        <item name="android:textColor">@color/texte</item>
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/fond</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Thème de l'application (compléments pour Android 8.1+ et 10+ : values-v27, values-v29) -->
    <style name="Theme.Pegasus" parent="Theme.Pegasus.Base" />

    <!-- Textes -->
    <style name="Texte" parent="">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:textColor">@color/texte</item>
    </style>

    <style name="Texte.TitreEcran">
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Texte.Titre">
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Texte.Section">
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Texte.Corps">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/texte_doux</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="Texte.Petit">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/texte_doux</item>
    </style>

    <style name="Texte.Libelle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/texte_doux</item>
    </style>

    <style name="Texte.Valeur">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Texte.Pastille">
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <!-- Boutons -->
    <style name="Bouton" parent="android:Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/bouton_hauteur</item>
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Bouton.Principal">
        <item name="android:background">@drawable/bg_bouton_principal</item>
        <item name="android:textColor">@color/texte_bouton_principal</item>
    </style>

    <style name="Bouton.Contour">
        <item name="android:background">@drawable/bg_bouton_contour</item>
        <item name="android:textColor">@color/texte</item>
    </style>

    <style name="Bouton.Rouge">
        <item name="android:background">@drawable/bg_bouton_rouge</item>
        <item name="android:textColor">@color/surface</item>
    </style>

    <style name="Touche" parent="android:Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_touche</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/texte</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="BoutonIcone">
        <item name="android:layout_width">@dimen/bouton_icone</item>
        <item name="android:layout_height">@dimen/bouton_icone</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
