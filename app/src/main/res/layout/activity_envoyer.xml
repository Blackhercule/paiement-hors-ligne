<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:orientation="vertical"
    android:paddingStart="@dimen/marge_ecran"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/marge_ecran"
    android:paddingBottom="16dp">

    <include layout="@layout/barre_titre" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <!-- 1. Scanner le QR code du receveur -->
        <LinearLayout
            android:id="@+id/etatScan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_rond_menthe">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_qr"
                    android:tint="@color/vert" />
            </FrameLayout>

            <TextView
                style="@style/Texte.Titre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/scan_titre" />

            <TextView
                style="@style/Texte.Corps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/scan_explication" />

            <TextView
                android:id="@+id/erreurScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_alerte"
                android:fontFamily="@font/manrope_bold"
                android:padding="14dp"
                android:textColor="@color/rouge"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/boutonScanner"
                style="@style/Bouton.Principal"
                android:layout_marginTop="28dp"
                android:text="@string/scanner_qr" />
        </LinearLayout>

        <!-- 2. Connexion au point d'accès du receveur -->
        <LinearLayout
            android:id="@+id/etatConnexion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/vert" />

            <TextView
                android:id="@+id/texteConnexion"
                style="@style/Texte.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textSize="18sp" />

            <TextView
                style="@style/Texte.Corps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/connexion_aide"
                android:textSize="14sp" />

            <Button
                android:id="@+id/boutonAnnulerConnexion"
                style="@style/Bouton.Contour"
                android:layout_marginTop="28dp"
                android:text="@string/annuler" />
        </LinearLayout>

        <!-- 3. Saisie du montant -->
        <LinearLayout
            android:id="@+id/etatMontant"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_carte"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/avatarReceveur"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_rond_menthe"
                    android:fontFamily="@font/manrope_extrabold"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/vert"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nomReceveur"
                        style="@style/Texte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/manrope_bold"
                        android:maxLines="1"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/detailReceveur"
                        style="@style/Texte.Petit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    style="@style/Texte.Pastille"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pastille_menthe"
                    android:drawableStart="@drawable/ic_cadenas_petit"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/vert_fonce"
                    android:gravity="center_vertical"
                    android:text="@string/aes_256"
                    android:textColor="@color/vert_fonce" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/manrope_semibold"
                android:gravity="center"
                android:text="@string/montant_a_envoyer"
                android:textColor="@color/texte_doux"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/montant"
                    style="@style/Texte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_extrabold"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="-0.03"
                    android:maxLines="1"
                    android:textSize="46sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/manrope_bold"
                    android:text="@string/fcfa"
                    android:textColor="@color/texte_doux"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/infoSolde"
                style="@style/Texte.Petit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center" />

            <!-- Pavé numérique : s'adapte à la hauteur de l'écran -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button android:id="@+id/touche1" style="@style/Touche" android:layout_marginEnd="8dp" android:text="1" />
                    <Button android:id="@+id/touche2" style="@style/Touche" android:layout_marginEnd="8dp" android:text="2" />
                    <Button android:id="@+id/touche3" style="@style/Touche" android:text="3" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button android:id="@+id/touche4" style="@style/Touche" android:layout_marginEnd="8dp" android:text="4" />
                    <Button android:id="@+id/touche5" style="@style/Touche" android:layout_marginEnd="8dp" android:text="5" />
                    <Button android:id="@+id/touche6" style="@style/Touche" android:text="6" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button android:id="@+id/touche7" style="@style/Touche" android:layout_marginEnd="8dp" android:text="7" />
                    <Button android:id="@+id/touche8" style="@style/Touche" android:layout_marginEnd="8dp" android:text="8" />
                    <Button android:id="@+id/touche9" style="@style/Touche" android:text="9" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button android:id="@+id/touche000" style="@style/Touche" android:layout_marginEnd="8dp" android:text="000" />
                    <Button android:id="@+id/touche0" style="@style/Touche" android:layout_marginEnd="8dp" android:text="0" />

                    <ImageButton
                        android:id="@+id/toucheEffacer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_touche"
                        android:contentDescription="@string/effacer"
                        android:scaleType="center"
                        android:src="@drawable/ic_effacer"
                        android:tint="@color/texte" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/boutonEnvoyer"
                style="@style/Bouton.Principal"
                android:enabled="false"
                android:text="@string/saisir_montant" />
        </LinearLayout>

        <!-- 4. En attente du reçu -->
        <LinearLayout
            android:id="@+id/etatAttente"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/vert" />

            <TextView
                android:id="@+id/texteAttente"
                style="@style/Texte.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textSize="18sp" />

            <TextView
                style="@style/Texte.Corps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/attente_recu"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 5. Résultat : confirmé, ou en attente (sera renvoyé) -->
        <ScrollView
            android:id="@+id/etatResultat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_carte"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <FrameLayout
                        android:id="@+id/rondResultat"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_rond_menthe">

                        <ImageView
                            android:id="@+id/iconeResultat"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/titreResultat"
                        style="@style/Texte.Titre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" />

                    <TextView
                        android:id="@+id/texteResultat"
                        style="@style/Texte.Corps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/montantResultat"
                        style="@style/Texte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:fontFeatureSettings="tnum"
                        android:textSize="32sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_carte"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView style="@style/Texte.Libelle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/receveur" />
                        <TextView android:id="@+id/detailNom" style="@style/Texte.Valeur" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <include layout="@layout/separateur" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView style="@style/Texte.Libelle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nouveau_solde" />
                        <TextView android:id="@+id/detailSolde" style="@style/Texte.Valeur" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <include layout="@layout/separateur" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView style="@style/Texte.Libelle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/canal" />
                        <TextView style="@style/Texte.Valeur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/canal_valeur" />
                    </LinearLayout>

                    <include layout="@layout/separateur" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView style="@style/Texte.Libelle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/statut" />
                        <TextView android:id="@+id/detailStatut" style="@style/Texte.Pastille" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="20dp" />

                <Button
                    android:id="@+id/boutonTerminer"
                    style="@style/Bouton.Principal"
                    android:text="@string/terminer" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
