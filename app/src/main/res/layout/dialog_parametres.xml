<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_semibold"
        android:labelFor="@+id/champNom"
        android:text="@string/votre_nom"
        android:textColor="@color/texte_doux"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/champNom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:autofillHints="name"
        android:background="@drawable/bg_champ"
        android:fontFamily="@font/manrope_regular"
        android:hint="@string/nom_indice"
        android:imeOptions="actionDone"
        android:inputType="textPersonName|textCapWords"
        android:maxLength="30"
        android:minHeight="48dp"
        android:padding="14dp"
        android:textColor="@color/texte"
        android:textSize="16sp" />

    <TextView
        style="@style/Texte.Petit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/nom_explication"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/infosAppareil"
        style="@style/Texte.Petit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:lineSpacingMultiplier="1.3"
        android:textSize="12sp" />
</LinearLayout>
