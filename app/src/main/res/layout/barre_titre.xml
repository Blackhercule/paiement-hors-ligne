<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bouton_icone"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/boutonRetour"
        style="@style/BoutonIcone"
        android:background="@drawable/bg_bouton_blanc"
        android:contentDescription="@string/retour"
        android:src="@drawable/ic_retour"
        android:tint="@color/texte" />

    <TextView
        android:id="@+id/titreEcran"
        style="@style/Texte.TitreEcran"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        android:gravity="center" />

    <View
        android:layout_width="@dimen/bouton_icone"
        android:layout_height="@dimen/bouton_icone" />
</LinearLayout>
