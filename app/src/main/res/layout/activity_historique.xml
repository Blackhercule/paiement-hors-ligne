<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:orientation="vertical"
    android:paddingStart="@dimen/marge_ecran"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/marge_ecran">

    <include layout="@layout/barre_titre" />

    <!-- Totaux -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_carte_vert"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_semibold"
                android:text="@string/total_recu"
                android:textColor="@color/entete_doux"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/totalRecu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_extrabold"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/surface"
                android:textSize="19sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_semibold"
                android:text="@string/total_envoye"
                android:textColor="@color/entete_doux"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/totalEnvoye"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_extrabold"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/or"
                android:textSize="19sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filtre -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_segment"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/filtreTout"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:text="@string/filtre_tout"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/filtreEnvoyes"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:text="@string/filtre_envoyes"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/filtreRecus"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:text="@string/filtre_recus"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <ListView
            android:id="@+id/liste"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@color/transparent"
            android:dividerHeight="6dp"
            android:listSelector="@color/transparent"
            android:paddingBottom="16dp"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/vide"
            style="@style/Texte.Petit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="@string/aucune_operation"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
