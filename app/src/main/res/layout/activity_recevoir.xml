<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/marge_ecran"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/marge_ecran"
    android:paddingBottom="16dp">

    <include layout="@layout/barre_titre" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/pastilleStatut"
                style="@style/Texte.Pastille"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_pastille_ambre"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:textColor="@color/ambre_texte"
                android:textSize="13sp" />

            <!-- QR code à faire scanner au payeur -->
            <LinearLayout
                android:id="@+id/carteQr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_carte_qr"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="22dp">

                <FrameLayout
                    android:layout_width="236dp"
                    android:layout_height="236dp">

                    <ImageView
                        android:id="@+id/imageQr"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/qr_description"
                        android:scaleType="fitCenter" />

                    <ProgressBar
                        android:id="@+id/chargementQr"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/vert" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nomRecevoir"
                    style="@style/Texte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/manrope_extrabold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/idRecevoir"
                    style="@style/Texte.Petit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Paiement reçu -->
            <LinearLayout
                android:id="@+id/carteRecu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="assertive"
                android:background="@drawable/bg_carte"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_rond_menthe">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check"
                        android:tint="@color/vert" />
                </FrameLayout>

                <TextView
                    style="@style/Texte.Titre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/paiement_recu"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/montantRecu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/manrope_extrabold"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/vert"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/deQui"
                    style="@style/Texte.Libelle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Erreur (permission, localisation, point d'accès) -->
            <LinearLayout
                android:id="@+id/carteErreur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_alerte"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/texteErreur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="@color/rouge"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/boutonErreur"
                    style="@style/Bouton.Principal"
                    android:layout_marginTop="14dp"
                    android:text="@string/reessayer" />
            </LinearLayout>

            <Button
                android:id="@+id/boutonNouvelleSession"
                style="@style/Bouton.Principal"
                android:layout_marginTop="16dp"
                android:text="@string/nouvelle_session"
                android:visibility="gone" />

            <TextView
                android:id="@+id/explication"
                style="@style/Texte.Corps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/recevoir_explication"
                android:textSize="14sp" />

            <!-- Garanties de la session -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_carte"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_carre12_bleu">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_wifi"
                            android:tint="@color/bleu_texte" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/Texte.Petit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/point_acces" android:textSize="12sp" />
                        <TextView android:id="@+id/texteReseau" style="@style/Texte.Valeur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/en_preparation" />
                    </LinearLayout>
                </LinearLayout>

                <include layout="@layout/separateur" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_carre12_menthe">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cadenas"
                            android:tint="@color/vert" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/Texte.Petit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chiffrement" android:textSize="12sp" />
                        <TextView style="@style/Texte.Valeur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chiffrement_valeur" />
                    </LinearLayout>
                </LinearLayout>

                <include layout="@layout/separateur" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_carre12_argile">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_bouclier"
                            android:tint="@color/argile_texte" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/Texte.Petit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/securite" android:textSize="12sp" />
                        <TextView style="@style/Texte.Valeur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/securite_valeur" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/boutonFermer"
        style="@style/Bouton.Contour"
        android:layout_marginTop="8dp"
        android:text="@string/fermer_session" />
</LinearLayout>
